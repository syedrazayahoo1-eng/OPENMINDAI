{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=LocalMindAI.db"
  },

  "Database": {
    "Provider": "Sqlite"
  },

  "Jwt": {
    "Key": "",
    "Issuer": "LocalMindAI",
    "Audience": "LocalMindAIUsers",
    "ExpiryInMinutes": 15,
    "RefreshTokenExpiryDays": 1,
    "RememberMeRefreshTokenExpiryDays": 30
  },

  "AIGateway": {
    "DefaultProvider": "AzureOpenAI"
  },

  "AzureOpenAI": {
    "Endpoint": "https://mindblock-resource.openai.azure.com/",
    "ApiKey": "",
    "DeploymentName": "gpt-5-mini",
    "ApiVersion": "2024-10-21"
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultModel": "qwen2.5-coder:7b"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "localhost;127.0.0.1"
}
